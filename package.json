{
  "name": "fruit-kingdom",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,cyan \"vite --host 0.0.0.0\" \"node --watch server/index.mjs\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test src/game/*.test.ts src/*.test.ts",
    "art": "python3 scripts/draw-art.py"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "matter-js": "^0.20.0",
    "pixi.js": "^8.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
