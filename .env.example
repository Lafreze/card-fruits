PORT=3000
# Mount a persistent volume here in production; run ONE server instance.
DATA_DIR=./server/data
# Direct connections ignore forwarded headers by default.
# Behind your own reverse proxy, set its exact trusted IP/CIDR (or known hop count).
# TRUST_PROXY=loopback
# Railway HTTP deployments automatically use the edge-supplied X-Real-IP and
# RAILWAY_VOLUME_MOUNT_PATH, if DATA_DIR is not explicitly configured.
